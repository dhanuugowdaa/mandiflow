# ==============================================================================
# MandiFlow Real-Time Agricultural Logistics Backend Configuration
# ==============================================================================
# Fill in your external API keys below to enable direct live integrations.
# If any key is left empty, the platform automatically runs high-fidelity,
# deterministic real-time simulations and graceful fallbacks.

# Server Port
PORT=5000

# ------------------------------------------------------------------------------
# 1. Agmarknet Live Market Data API (data.gov.in)
# ------------------------------------------------------------------------------
# Resource: Daily Mandi / APMC Commodity Prices across Indian Mandis
# Sign up & get free API Key at: https://data.gov.in/
DATA_GOV_IN_API_KEY=

# ------------------------------------------------------------------------------
# 2. Kisan OTP SMS Gateway (Real SMS Delivery to Farmers' Phones)
# ------------------------------------------------------------------------------
# Select provider: 'fast2sms' | 'twilio' | 'msg91' | 'mock'
SMS_PROVIDER=mock

# Fast2SMS (Indian Bulk SMS Gateway)
# Sign up at: https://www.fast2sms.com/
FAST2SMS_API_KEY=

# Or Twilio (Global SMS API)
# Sign up at: https://www.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 3. Ambient Weather & Arrhenius Shelf-Life Kinetics API (OpenWeatherMap / IMD)
# ------------------------------------------------------------------------------
# Used for live temperature & humidity in Nashik, Azadpur, and Vashi mandis.
# Sign up at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# ------------------------------------------------------------------------------
# 4. OpenRouteService / OSRM Reefer Corridor Route Telematics
# ------------------------------------------------------------------------------
# Used for live heavy vehicle truck corridor routing along NH-48.
# Sign up at: https://openrouteservice.org/
OPENROUTESERVICE_API_KEY=

# ------------------------------------------------------------------------------
# 5. Security & DPDP Act 2023 Cryptographic Salt
# ------------------------------------------------------------------------------
JWT_SECRET=mandiflow_dpdp_act_2023_secret_salt_hash
